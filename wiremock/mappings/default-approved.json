{
  "priority": 10,
  "request": {
    "method": "POST",
    "urlPath": "/provider/v1/execute"
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": {
      "transactionId": "txn-{{randomValue length=8 type='ALPHANUMERIC'}}",
      "status": "APPROVED",
      "balance": "{{jsonPath request.body '$.amount'}}",
      "executedAt": "{{now}}"
    },
    "transformers": ["response-template"]
  }
}
